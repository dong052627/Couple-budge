rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.partnerUid == request.auth.uid);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && (request.auth.uid == userId || userId == 'mock-partner-' + request.auth.uid) && isValidUser(incoming(), userId);
      
      allow update: if isSignedIn() && (
        // Case A: The user fully manages and updates their own mock-partner profile
        (userId == 'mock-partner-' + request.auth.uid && isValidUser(incoming(), userId)) ||
        // Case B: Symmetrical profile updates for the user's own profile or their paired partner's profile
        ((request.auth.uid == userId || resource.data.partnerUid == request.auth.uid) && isValidUser(incoming(), userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'partnerCode', 'partnerUid', 'partnerName', 'status', 'spaceId', 'updatedAt'
          ])
        ))
      );

      allow delete: if false; // Profiles are immortal
    }

    function isValidUser(data, userId) {
      return (data.uid == userId)
        && data.displayName is string && data.displayName.size() <= 128
        && data.email is string && data.email.size() <= 128
        && data.myCode is string && data.myCode.size() <= 32
        && data.status in ['unbound', 'binding', 'bound']
        && (data.partnerCode == null || (data.partnerCode is string && data.partnerCode.size() <= 32))
        && (data.partnerUid == null || (data.partnerUid is string && data.partnerUid.size() <= 128))
        && (data.partnerName == null || (data.partnerName is string && data.partnerName.size() <= 128))
        && (data.spaceId == null || (data.spaceId is string && data.spaceId.size() <= 128));
    }

    // Expenses Collection rules
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.participants);
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants);

      allow create: if isSignedIn() 
        && isValidExpense(incoming()) 
        && (incoming().payerId == request.auth.uid || request.auth.uid in incoming().participants);

      allow update: if isSignedIn()
        && isValidExpense(incoming())
        && (request.auth.uid in existing().participants)
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'category', 'amount', 'payerName', 'payerId', 'date', 'note',
            'splitType', 'fullBearerId', 'fullBearerName', 'customShares', 'updatedAt',
            'spaceId', 'participants'
          ])
        );

      allow delete: if isSignedIn() && (request.auth.uid in existing().participants);
    }

    function isValidExpense(data) {
      return data.id is string && data.id.size() <= 128
        && data.spaceId is string && data.spaceId.size() <= 128
        && data.category is string && data.category.size() <= 64
        && data.amount is number && data.amount >= 0
        && data.payerId is string && data.payerId.size() <= 128
        && data.payerName is string && data.payerName.size() <= 128
        && data.date is string && data.date.size() <= 16
        && data.note is string && data.note.size() <= 200
        && data.splitType in ['50/50', 'single', 'custom']
        && (data.fullBearerId == null || (data.fullBearerId is string && data.fullBearerId.size() <= 128))
        && (data.fullBearerName == null || (data.fullBearerName is string && data.fullBearerName.size() <= 128))
        && data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 2
        && request.auth.uid in data.participants;
    }

  }
}
