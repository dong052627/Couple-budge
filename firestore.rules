rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net default catch-all: Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.get('partnerUid', '') == request.auth.uid);
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() && (request.auth.uid == userId || userId == 'mock-partner-' + request.auth.uid) && isValidUser(incoming(), userId);
      
      allow update: if isSignedIn() && (
        // Case A: The user fully manages and updates their own mock-partner profile
        (userId == 'mock-partner-' + request.auth.uid && isValidUser(incoming(), userId)) ||
        // Case B: Symmetrical profile updates for the user's own profile or their paired partner's profile
        ((request.auth.uid == userId || resource.data.get('partnerUid', '') == request.auth.uid) && (
          [
            'partnerCode', 'partnerUid', 'partnerName', 'status', 'spaceId', 'updatedAt'
          ].hasAll(incoming().diff(existing()).affectedKeys())
          && (incoming().get('status', 'unbound') in ['unbound', 'binding', 'bound'])
        ))
      );

      allow delete: if false; // Profiles are immortal
    }

    function isValidUser(data, userId) {
      return (data.get('uid', userId) == userId)
        && (data.get('status', 'unbound') in ['unbound', 'binding', 'bound'])
        && (data.get('partnerCode', '') is string)
        && (data.get('partnerUid', '') is string)
        && (data.get('partnerName', '') is string)
        && (data.get('spaceId', '') is string);
    }

    // Expenses Collection rules
    match /expenses/{expenseId} {
      allow get: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
      allow list: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));

      allow create: if isSignedIn() 
        && isValidExpense(incoming()) 
        && (incoming().get('payerId', '') == request.auth.uid || request.auth.uid in incoming().get('participants', []));

      allow update: if isSignedIn()
        && isValidExpense(incoming())
        && (request.auth.uid in existing().get('participants', []))
        && (
          [
            'category', 'amount', 'payerName', 'payerId', 'date', 'note',
            'splitType', 'fullBearerId', 'fullBearerName', 'customShares', 'updatedAt',
            'spaceId', 'participants'
          ].hasAll(incoming().diff(existing()).affectedKeys())
        );

      allow delete: if isSignedIn() && (request.auth.uid in existing().get('participants', []));
    }

    function isValidExpense(data) {
      return data.get('id', '') is string
        && data.get('spaceId', '') is string
        && data.get('category', '') is string
        && data.get('amount', 0) is number && data.get('amount', 0) >= 0
        && data.get('payerId', '') is string
        && data.get('payerName', '') is string
        && data.get('date', '') is string
        && data.get('note', '') is string
        && data.get('splitType', '50/50') in ['50/50', 'single', 'custom']
        && data.get('participants', []) is list
        && request.auth.uid in data.get('participants', []);
    }

  }
}
